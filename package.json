{
  "name": "@twitchapis/twitch.js",
  "version": "2.0.0-beta.9",
  "description": "Twitch.JS is a Nodejs library made with typescript to interact with the Twitch API in a simple and easy way.",
  "keywords": [
    "nodejs",
    "twitch",
    "twitchtv",
    "twitchirc",
    "twitch-api",
    "bot",
    "chat",
    "message"
  ],
  "type": "commonjs",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "npx tsc --build",
    "prepack": "npm run build",
    "lint": "eslint ./src --fix",
    "test": "node ./tests/tester.js",
    "genDocs": "npx typedoc --options typedoc.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promisependingapis/twitch.js.git"
  },
  "author": "PromisePendingApis Team",
  "contributors": [
    "LoboMetalurgico",
    "SpaceFox"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/promisependingapis/twitch.js/issues"
  },
  "homepage": "https://twitch.js.org",
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@promisepending/logger.js": "^1.1.2",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
